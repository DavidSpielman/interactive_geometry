<?xml version="1.0"?>
<launch>
    <arg name="rviz_config" default="$(find-pkg-share interactive_geometry)/config/rviz/config.rviz"/>

    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)"/>

    <!-- Launch node with cwd being that of the node, so the files will be saved there instead of $ROS_HOME -->
    <node name="interactive_ellipsoid_server_node" pkg="interactive_geometry" exec="interactive_ellipsoid_server_node" output="screen">
        <param name="a" value="2.3" />
        <param name="b" value="1.5" />
        <param name="c" value="3.9" />
    </node>

    <node name="interactive_ellipsoid_client_node" pkg="interactive_geometry_examples" exec="interactive_ellipsoid_client_node"  output="screen"/>-->
</launch>
